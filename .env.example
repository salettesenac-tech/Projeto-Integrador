# PostgreSQL (Neon / Vercel Postgres)
# Copie a connection string do painel do Neon.
DATABASE_URL=postgresql://usuario:senha@host.neon.tech/vivalingua?sslmode=require

# Segredo usado para assinar/hashear os códigos de recuperação de senha.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=troque-por-uma-string-aleatoria-bem-longa

# Opcional: envio real do código por e-mail (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=VivaLingua <onboarding@resend.dev>

# Apenas para demonstração: devolve o código de recuperação no JSON
# quando não há envio real configurado. NUNCA use "true" em produção real.
DEMO_MOSTRAR_CODIGO=true
